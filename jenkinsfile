pipeline {
  agent any

  environment {
    ANSIBLE_HOST = "20.198.179.127"
    ANSIBLE_USER = "boho"
  }

  stages {
    stage('📥 Clone Repo ใหม่บน Ansible VM') {
      steps {
        sshagent(credentials: ['ssh-ansible-agent']) {
          sh '''
            ssh -o StrictHostKeyChecking=no ${ANSIBLE_USER}@${ANSIBLE_HOST} '
              REPO_URL="https://github.com/kitsanaphon1/ANSIBLE-INSTALLDOCKER-DEPLOY.git"
              WORKDIR="/home/boho/install-docker-deploy"

              echo "🧹 ลบโฟลเดอร์เดิม (ถ้ามี)"
              rm -rf "$WORKDIR"

              echo "📥 Clone ใหม่"
              git clone "$REPO_URL" "$WORKDIR"
            '
          '''
        }
      }
    }

    stage('🚀 Run Ansible Playbook ติดตั้ง Docker') {
      steps {
        sshagent(credentials: ['ssh-ansible-agent']) {
          sh '''
            ssh -o StrictHostKeyChecking=no ${ANSIBLE_USER}@${ANSIBLE_HOST} '
              WORKDIR="/home/boho/install-docker-deploy"
              source ~/ansible-env/bin/activate &&
              cd "$WORKDIR/playbooks" &&
              ansible-playbook install-docker.yaml -i "$(cat ~/vm_ip.txt)," \
                -e ansible_user=azureuser
            '
          '''
        }
      }
    }
  }
}
