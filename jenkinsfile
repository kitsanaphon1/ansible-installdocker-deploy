pipeline {
  agent any  // 📌 ใช้ Jenkins agent ใดก็ได้ที่ว่างอยู่

  environment {
    ANSIBLE_HOST = "20.198.179.127"  // 🌐 IP ของเครื่อง Ansible VM
    ANSIBLE_USER = "boho"            // 👤 ชื่อ user สำหรับ ssh เข้า Ansible VM
  }

  stages {

    stage('📂 ดึงไฟล์ vm_ip.txt จาก Terraform Job') {
      steps {
        copyArtifacts(
          projectName: 'terraform',
          filter: 'vm_ip.txt',
          selector: [$class: 'StatusBuildSelector']
        )
      }
    }

    stage('📤 ส่ง vm_ip.txt ไปยัง Ansible VM') {
      steps {
        sshagent(credentials: ['ssh-ansible-agent']) {
          sh '''
            scp -o StrictHostKeyChecking=no vm_ip.txt ${ANSIBLE_USER}@${ANSIBLE_HOST}:~/vm_ip.txt
          '''
        }
      }
    }

    stage('🔐 ส่ง private key เข้า Ansible VM') {
      steps {
        sshagent(credentials: ['ssh-tfproj-test']) {
          sh '''
            echo "📦 สร้างไฟล์ชั่วคราวจาก Jenkins Credential"
            TEMP_KEY="/tmp/temp_id_rsa"
            ssh-add -L | sed '1d;$d' > $TEMP_KEY
            chmod 600 $TEMP_KEY

            echo "📤 ส่ง key ไปยัง Ansible VM"
            scp -o StrictHostKeyChecking=no $TEMP_KEY ${ANSIBLE_USER}@${ANSIBLE_HOST}:~/.ssh/id_rsa

            echo "🧹 ลบ key ชั่วคราวใน Jenkins agent"
            rm -f $TEMP_KEY
          '''
        }
      }
    }

    stage('🚀 Run Ansible Playbook ติดตั้ง Docker') {
      steps {
        sshagent(credentials: ['ssh-ansible-agent']) {
          sh '''
            ssh -o StrictHostKeyChecking=no ${ANSIBLE_USER}@${ANSIBLE_HOST} '
              export ANSIBLE_HOST_KEY_CHECKING=False
              WORKDIR="/home/boho/install-docker-deploy"
              source ~/ansible-env/bin/activate &&
              cd "$WORKDIR/playbooks" &&
              ansible-playbook install-docker.yaml -i "$(cat ~/vm_ip.txt)," \
                -e ansible_user=azureuser
            '
          '''
        }
      }
    }

    stage('🧹 ลบ private key จาก Ansible VM หลังใช้งาน') {
      steps {
        sshagent(credentials: ['ssh-ansible-agent']) {
          sh '''
            ssh -o StrictHostKeyChecking=no ${ANSIBLE_USER}@${ANSIBLE_HOST} '
              echo "🔐 ลบ ~/.ssh/id_rsa บน Ansible VM..."
              rm -f ~/.ssh/id_rsa
            '
          '''
        }
      }
    }

  }
}
